envfor() {
    curl -s -X POST -G "https://devenv.new/api/generate" \
    --data-urlencode "q=$*" \
    | jq -r '.devenv_nix'
}

mkenv() {
    working_directory=$(pwd)
    bash "$HOME/nixos-config/dotfiles/mkenv.sh" $1
    cd "$working_directory"
}

rebuild() {
    sudo nixos-rebuild switch --flake $@
}
